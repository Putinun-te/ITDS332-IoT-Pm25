# Copy this file to .env.automation and fill values for your environment.
TIMEZONE=Asia/Bangkok
RANDOM_STATE=42

# Firebase
FIREBASE_RTD_URL=https://itds332-pm25-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_AUTH=
FIREBASE_PATH=/AirQuality/Log
FIREBASE_PATH_CANDIDATES=/AirQuality/Log,/air_quality_readings,/AirQuality,/

# Data source behavior
USE_LOCAL_FALLBACK=true
LOCAL_FALLBACK_PATH=data/openmeteo_bangkok_hourly_2023_2026.csv
MERGE_LOCAL_WITH_FIREBASE=true

# Output
MODELS_DIR=models

# Forecast push behavior
PUSH_FORECAST_TO_FIREBASE=true
FIREBASE_FORECAST_PATH=/predictions/next_day.json
FIREBASE_PREVIOUS_DAY_PATH=/predictions/previous_day.json
FIREBASE_HISTORY_BASE_PATH=/predictions/history
