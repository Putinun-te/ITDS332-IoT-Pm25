  {
    "id": "0ab6fb4a8a30d1c8",
    "type": "function",
    "z": "f1a0c93b1e71c0a1",
    "name": "Validate + map",
    "func": "const d = msg.payload || {};\nif (!d.forecast_date) {\n    node.status({fill:\"red\", shape:\"ring\", text:\"no forecast data\"});\n    return null;\n}\n\nconst pm25 = Number(d.pm25_forecast ?? NaN);\nconst pm10 = Number(d.pm10_forecast ?? NaN);\nconst stale = Boolean(d.is_stale_vs_today);\n\nconst text = `Forecast ${d.forecast_date} | PM2.5 ${pm25.toFixed(2)} | PM10 ${pm10.toFixed(2)}`;\nconst staleText = stale ? \"STALE: data is behind today\" : \"OK: data is current\";\n\nnode.status({fill: stale ? \"yellow\" : \"green\", shape:\"dot\", text: staleText});\n\nreturn [\n  {payload: text},\n  {payload: pm25},\n  {payload: pm10},\n  {payload: staleText},\n  {payload: {\n      latest_history_date: d.latest_history_date || null,\n      forecast_date: d.forecast_date,\n      pm25_forecast: pm25,\n      pm10_forecast: pm10,\n      is_stale_vs_today: stale\n  }}\n];",
    "outputs": 5,
    "noerr": 0,
