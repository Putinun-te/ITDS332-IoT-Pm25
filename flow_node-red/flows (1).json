    {
        "id": "037159e57e32d761",
        "type": "function",
        "z": "f1a0c93b1e71c0a1",
        "name": "แยกข้อมูลไปโชว์ที่ Dashboard",
        "func": "const data = msg.payload;\n\n// ถ้าไม่มีข้อมูล ให้ส่งข้อความแจ้งเตือนกลับไป\nif (!data || Object.keys(data).length === 0) {\n    node.status({fill:\"red\", shape:\"ring\", text:\"ไม่พบข้อมูล\"});\n    return [null, null, {payload: \"ไม่สามารถดึงข้อมูลได้\"}];\n}\n\n// ดึงข้อมูลรายการล่าสุด\nconst latestKey = Object.keys(data)[0];\nconst latestData = data[latestKey];\n\n// แปลงค่าให้เป็นตัวเลข และดึงเวลามาโชว์\nconst pm25 = Number(latestData.pm25 || 0);\nconst pm10 = Number(latestData.pm10 || 0);\nconst timestamp = latestData.timestamp || \"ไม่ระบุเวลา\";\n\n// แสดงสถานะสีเขียวที่ตัวโหนด\nnode.status({fill:\"green\", shape:\"dot\", text: \"อัปเดต: \" + timestamp});\n\n// ส่งข้อมูลออกไป 3 เส้นทาง (เส้น1=PM2.5, เส้น2=PM10, เส้น3=เวลาที่อัปเดต)\nreturn [\n    { payload: pm25 },\n    { payload: pm10 },\n    { payload: timestamp }\n];",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
